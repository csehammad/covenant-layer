{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://covenant-layer.org/spec/schemas/dispute-record.v1.schema.json",
  "title": "Covenant Dispute Record v1",
  "description": "Versioned payload definitions for dispute records and dispute resolutions. Prose fields (statement) are supplementary; settlement logic MUST NOT depend on interpreting free text.",
  "type": "object",
  "$defs": {
    "reasonCode": {
      "type": "string",
      "enum": [
        "terms_mismatch",
        "missing_evidence",
        "late_fulfillment",
        "duplicate_charge",
        "non_delivery"
      ]
    },
    "disputeStatus": {
      "type": "string",
      "enum": ["open", "investigating", "resolved", "closed"]
    },
    "resolutionDecision": {
      "type": "string",
      "enum": ["fulfilled", "failed", "refunded"]
    },
    "evidenceRef": {
      "type": "object",
      "required": ["type", "digest"],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "additionalProperties": true
    },
    "disputeRecordPayload": {
      "type": "object",
      "required": [
        "dispute_id",
        "commitment_ref",
        "raised_by",
        "reason_code",
        "evidence_refs",
        "opened_at",
        "response_deadline",
        "status"
      ],
      "properties": {
        "dispute_id": { "type": "string", "minLength": 3 },
        "commitment_ref": { "type": "string", "minLength": 3 },
        "raised_by": { "type": "string", "minLength": 3 },
        "reason_code": { "$ref": "#/$defs/reasonCode" },
        "statement": { "type": "string" },
        "evidence_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceRef" },
          "minItems": 1
        },
        "opened_at": { "type": "string", "format": "date-time" },
        "response_deadline": { "type": "string", "format": "date-time" },
        "status": { "$ref": "#/$defs/disputeStatus" }
      },
      "additionalProperties": true
    },
    "disputeResolutionPayload": {
      "type": "object",
      "required": [
        "resolution_id",
        "dispute_id",
        "commitment_ref",
        "decision",
        "resolved_by",
        "resolution_evidence_refs",
        "resolved_at",
        "settlement_state"
      ],
      "properties": {
        "resolution_id": { "type": "string", "minLength": 3 },
        "dispute_id": { "type": "string", "minLength": 3 },
        "commitment_ref": { "type": "string", "minLength": 3 },
        "decision": { "$ref": "#/$defs/resolutionDecision" },
        "resolved_by": { "type": "string", "minLength": 3 },
        "resolution_evidence_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceRef" }
        },
        "resolved_at": { "type": "string", "format": "date-time" },
        "settlement_state": { "$ref": "#/$defs/resolutionDecision" }
      },
      "additionalProperties": true
    }
  }
}
